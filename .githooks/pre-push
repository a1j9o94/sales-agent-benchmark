#!/bin/bash
echo "Running pre-push quality gates..."

# Try to run build if build script exists (critical - must pass)
if [ -f "build.ts" ]; then
  echo "Running build..."
  bun run build
  if [ $? -ne 0 ]; then
    echo "❌ Build failed. Fix issues before pushing."
    exit 1
  fi
fi

# Check if Bun is available for TypeScript check (informational only)
if ! command -v bun >/dev/null 2>&1; then
  echo "⚠️  Bun not found, skipping TypeScript check"
else
  # Run TypeScript type checking (warn but don't block)
  echo "Running TypeScript type check..."
  bun x tsc --noEmit
  if [ $? -ne 0 ]; then
    echo "⚠️  TypeScript type errors detected. Consider fixing before merging."
  fi
fi

echo "✅ Pre-push checks passed."
